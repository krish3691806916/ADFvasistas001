{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfvasistas001"
		},
		"snowflake_de_demo_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'snowflake_de_demo'"
		},
		"snowflake_de_demo_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DEMO_DB"
		},
		"snowflake_de_demo_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfvasistas001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"snowflake_de_demo_password": {
						"value": "[parameters('snowflake_de_demo_password')]"
					},
					"snowflake_de_demo_properties_typeProperties_database": {
						"value": "[parameters('snowflake_de_demo_properties_typeProperties_database')]"
					},
					"snowflake_de_demo_properties_typeProperties_role": {
						"value": "[parameters('snowflake_de_demo_properties_typeProperties_role')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}